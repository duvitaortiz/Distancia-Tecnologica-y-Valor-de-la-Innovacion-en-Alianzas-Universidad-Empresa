def predecir_base(base_model, rank_val=None):
    Xb = pd.DataFrame({
        'DeTech_c'    : grid,
        'DeTech_c_sq' : grid**2,
        'Experticia'  : med_exp,
        'Inventores'  : med_inv,
    })
    if rank_val is not None:
        Xb['Rank'] = rank_val
    Xb = sm.add_constant(Xb, has_constant='add')
    mu = base_model.predict(Xb)
    return np.clip(mu, 0, np.percentile(mu, 99))


def predecir_mod(mod_model, val_log_c, rank_val=None):
    Xm = pd.DataFrame({
        'DeTech_c'    : grid,
        'DeTech_c_sq' : grid**2,
        'Experticia'  : med_exp,
        'Inventores'  : med_inv,
        'SumLog_c'    : val_log_c,
        'SumLog_c_sq' : val_log_c**2,
        'Interaction' : grid * val_log_c,
    })
    if rank_val is not None:
        Xm['Rank'] = rank_val
    Xm = sm.add_constant(Xm, has_constant='add')
    mu = mod_model.predict(Xm)
    return np.clip(mu, 0, np.percentile(mu, 99))


