                              df_modelo['SumLog_c'].max(), 100)

configs7 = [
    (axes[0], mod_all, None,  "Muestra Completa"),
    (axes[1], mod_r1,  1,     "Rank=1"),
    (axes[2], mod_r0,  0,     "Rank=0"),
]

for ax, mmod, rv, titulo in configs7:
    # El efecto marginal en NB2 es aproximado como la derivada de log(μ)
    # respecto a DeTech_c evaluada en la media de DeTech_c=0 (centrado)
    b1  = mmod.params.get('DeTech_c',   0)
    b2  = mmod.params.get('DeTech_c_sq',0)
    b_i = mmod.params.get('Interaction',0)
    # Efecto marginal en DeTech=media (grid=0): b1 + b_i * SumLog_c
    em = b1 + b_i * SumLog_c_range
    SumLog_orig_range = SumLog_c_range + SumLog_mean
    ax.plot(SumLog_orig_range, em, color=PAL['base'], lw=2.5)
    ax.axhline(0, color=PAL['alto'], lw=1.3, linestyle='--',
               label='Efecto = 0')
    ax.fill_between(SumLog_orig_range, em, 0,
                    where=(em > 0), color=PAL['medio'], alpha=0.2,
                    label='Positivo')
    ax.fill_between(SumLog_orig_range, em, 0,
                    where=(em <= 0), color=PAL['alto'], alpha=0.2,
                    label='Negativo')
    # Punto de cruce
    if b_i != 0:
        cruce_c = -b1 / b_i
        cruce_orig = cruce_c + SumLog_mean
        if (SumLog_c_range.min() < cruce_c < SumLog_c_range.max()):
            ax.axvline(cruce_orig, color='black', lw=1.5, linestyle=':',
                       label=f'Cruce ≈{cruce_orig:.2f}')
    ax.set_title(titulo)
    ax.set_xlabel("log(SumPatents+1)")
    ax.set_ylabel("Efecto marginal de DeTech (en media)")
    ax.legend(fontsize=8)

