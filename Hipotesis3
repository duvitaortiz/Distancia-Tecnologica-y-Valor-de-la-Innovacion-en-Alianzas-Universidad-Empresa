resultados = []

def correr_modelo(data, segmento):
    y = data['ValorInc']
    X = sm.add_constant(data[['DeTech_c','DeTech_c_sq',
                               'Experticia','Inventores',
                               'SumLog_c','SumLog_c_sq','Interaction']])
    if segmento == 'Completa':
        X = X.copy(); X['Rank'] = data['Rank']
    res = estimar_nb2(y, X)
    print(f"\n  [{segmento}]")
    print(res.summary2(float_format="%.4f"))
    resultados.append({
        'Segmento'         : segmento,
        'n'                : len(data),
        'Coef DeTech'      : res.params.get('DeTech_c', np.nan),
        'p DeTech'         : res.pvalues.get('DeTech_c', np.nan),
        'Coef DeTech²'     : res.params.get('DeTech_c_sq', np.nan),
        'p DeTech²'        : res.pvalues.get('DeTech_c_sq', np.nan),
        'Coef SumLog'      : res.params.get('SumLog_c', np.nan),
        'p SumLog'         : res.pvalues.get('SumLog_c', np.nan),
        'Coef SumLog²'     : res.params.get('SumLog_c_sq', np.nan),
        'p SumLog²'        : res.pvalues.get('SumLog_c_sq', np.nan),
        'Coef Interacción' : res.params.get('Interaction', np.nan),
        'p Interacción'    : res.pvalues.get('Interaction', np.nan),
        'alpha'            : res.params.get('alpha', np.nan),
        'AIC'              : res.aic,
        'BIC'              : res.bic,
        'Pseudo-R²'        : res.prsquared,
        'Log-Lik'          : res.llf,
    })
    return res

