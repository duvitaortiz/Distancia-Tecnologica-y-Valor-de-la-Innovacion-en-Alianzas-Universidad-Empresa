# =============================================================================
# 3. FUNCIÓN NB2
# =============================================================================
def estimar_nb2(y, X, metodo='bfgs'):
    model = NegativeBinomial(y, X, loglike_method='nb2')
    res   = model.fit(method=metodo, maxiter=5000, disp=0)
    return res

# =============================================================================
# 4. MODELOS BASE (sin moderador)
# =============================================================================
print("\n" + "=" * 70)
print("4. MODELOS BASE (SIN MODERADOR)")
print("=" * 70)

def modelo_base(data, segmento):
    y = data['ValorInc']
    X = sm.add_constant(data[['DeTech_c','DeTech_c_sq',
                               'Experticia','Inventores']])
    if segmento == 'Completa':
        X = X.copy(); X['Rank'] = data['Rank']
    res = estimar_nb2(y, X)
    print(f"\n  [{segmento}]  n={len(data)}  "
          f"AIC={res.aic:.1f}  alpha={res.params.get('alpha',np.nan):.4f}")
    return res

